<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- WinExe: 콘솔 창 없이 백그라운드로 동작한다. 로그는 logs\checkyou.log 로 남긴다. -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>CheckYou</AssemblyName>
    <RootNamespace>CheckYou</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <!-- config\config.json 을 출력 폴더의 같은 config\ 하위로 복사한다.
         디버그(bin\Debug\...)와 릴리즈(bin\Release\...) 양쪽 모두
         실행파일 옆 config\config.json 을 참조하게 된다. -->
    <None Update="config\config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
